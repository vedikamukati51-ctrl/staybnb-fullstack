<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stay-BNB: Listing Page</title>
  <link rel="stylesheet" href="/css/style.css">
    <script src="https://kit.fontawesome.com/b5177d8a6f.js" crossorigin="anonymous"></script>
</head>
<body>
<%- include("../includes/navbar.ejs") %>

    <div class="container">
    <div class="list-container">
      <div class="left-col">
        <p><%= allListings.length %> Options</p>
                <h1>Recommended Places</h1>

        <% allListings.forEach(listing => { %>
        <a href="/listings/<%= listing._id %>" style="text-decoration:none; color:inherit;">
                    <div class="house">
            <div class="house-img">
                <img src="<%= listing.image %>">
            </div>
            <div class="house-info">
              <p><%= listing.title %></p>
                <h3><%= listing.headline %></h3>
                    <p><%= listing.bedrooms %> Bedroom / <%= listing.bathrooms %> Bathroom / <%= listing.amenities %></p>
                <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
                <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star-half-stroke"></i>
                <i class="fa-regular fa-star"></i>
                <div class="house-price">
                <p><%= listing.guests %> Guest</p>
                    <h4>$ <%= listing.price %> <span>/ day</span></h4>
              </div>
            </div>
          </div>
        </a>
                <% }) %>
      </div>
    </div>
  </div>
</body>
</html>
